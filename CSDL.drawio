        <UserObject label="" mermaidData="{&#xA;  &quot;data&quot;: &quot;erDiagram\n    SAN_VAN_DONG ||--o{ DOI_BONG : \&quot;là sân nhà của\&quot;\n    SAN_VAN_DONG ||--o{ TRAN_DAU : \&quot;địa điểm tổ chức\&quot;\n    \n    DOI_BONG ||--|{ MAU_AO_DOI_BONG : \&quot;sở hữu màu áo\&quot;\n    DOI_BONG ||--o{ HOP_DONG_CAU_THU : \&quot;đội chủ quản\&quot;\n    DOI_BONG ||--o{ HOP_DONG_CAU_THU : \&quot;đang thi đấu tại\&quot;\n    DOI_BONG ||--o{ TRAN_DAU : \&quot;đóng vai trò đội nhà\&quot;\n    DOI_BONG ||--o{ TRAN_DAU : \&quot;đóng vai trò đội khách\&quot;\n    DOI_BONG ||--o{ DANG_KY_THI_DAU : \&quot;đăng ký cầu thủ\&quot;\n\n    CAU_THU ||--|{ HOP_DONG_CAU_THU : \&quot;ký kết hợp đồng\&quot;\n    CAU_THU ||--o{ DANG_KY_THI_DAU : \&quot;được đăng ký thi đấu\&quot;\n\n    VONG_DAU ||--|{ TRAN_DAU : \&quot;thuộc vòng đấu\&quot;\n\n    TRAN_DAU ||--|{ PHAN_CONG_TRONG_TAI : \&quot;được điều khiển bởi\&quot;\n    TRAN_DAU ||--|{ DANG_KY_THI_DAU : \&quot;có danh sách đăng ký\&quot;\n\n    DANG_KY_THI_DAU ||--o{ SU_KIEN_TRAN_DAU : \&quot;phát sinh sự kiện\&quot;\n\n    TRONG_TAI ||--o{ PHAN_CONG_TRONG_TAI : \&quot;được phân công nhiệm vụ\&quot;\n\n    SAN_VAN_DONG {\n        string MaSan PK\n        string TenSan\n        string DiaChi\n        int SucChua\n        string KhuVuc\n    }\n\n    DOI_BONG {\n        string MaDoi PK\n        string TenDoi\n        string HLV\n        string MaSanNha FK\n    }\n\n    MAU_AO_DOI_BONG {\n        string MaDoi PK, FK\n        string LoaiMauAo PK\n        string MoTaMau\n    }\n\n    CAU_THU {\n        string MaCauThu PK\n        string HoTen\n        date NgaySinh\n        string ViTri\n        string QuocTich\n    }\n\n    HOP_DONG_CAU_THU {\n        string MaHD PK\n        string MaCauThu FK\n        string MaDoiChuQuan FK\n        string MaDoiHienTai FK\n        int SoAo\n        date NgayBatDau\n        date NgayKetThuc\n        string TrangThai\n    }\n\n    TRONG_TAI {\n        string MaTrongTai PK\n        string HoTen\n        date NgaySinh\n        string QueQuan\n        string CapBac\n    }\n\n    VONG_DAU {\n        int MaVong PK\n        string TenVong\n        int ThuTu\n    }\n\n    TRAN_DAU {\n        string MaTran PK\n        int MaVong FK\n        string MaDoiNha FK\n        string MaDoiKhach FK\n        string MaSan FK\n        timestamp NgayGio\n        decimal GiaVe\n        int SoKhach\n        int BanThangNha\n        int BanThangKhach\n        int TheVangNha\n        int TheVangKhach\n        int TheDoNha\n        int TheDoKhach\n        string TrangThai\n    }\n\n    PHAN_CONG_TRONG_TAI {\n        string MaTran PK, FK\n        string VaiTro PK\n        string MaTrongTai FK\n    }\n\n    DANG_KY_THI_DAU {\n        string MaTran PK, FK\n        string MaCauThu PK, FK\n        string MaDoi FK\n        string VaiTroThiDau\n        int SoAoDangKy\n    }\n\n    SU_KIEN_TRAN_DAU {\n        string MaSuKien PK\n        string MaTran FK\n        string MaCauThu FK\n        string LoaiSuKien\n        int PhutGhiNhan\n    }&quot;,&#xA;  &quot;config&quot;: null,&#xA;  &quot;version&quot;: &quot;12&quot;&#xA;}" id="EKLj2zRwszJ1kTzLfVwn-1">
